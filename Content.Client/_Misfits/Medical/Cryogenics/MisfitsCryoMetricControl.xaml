<PanelContainer xmlns="https://spacestation14.io"
                xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                HorizontalExpand="True">
    <PanelContainer.PanelOverride>
        <graphics:StyleBoxFlat BackgroundColor="#20242E" />
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Horizontal">
        <PanelContainer Name="Accent" Access="Public" SetWidth="3" />
        <BoxContainer Orientation="Vertical" Margin="6 4" HorizontalExpand="True">
            <Label Name="Title" Access="Public" FontColorOverride="#9AA0AC" />
            <Label Name="Value" Access="Public" />
            <Label Name="Target" Access="Public" FontColorOverride="#6B7280" Visible="False" />
            <ProgressBar Name="Progress" Access="Public" MinValue="0" MaxValue="1" MinHeight="6" Visible="False" Margin="0 3 0 0" />
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
