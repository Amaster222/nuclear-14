<!-- #Cythisiax Add - Wendover Free Market Exchange -->
<DefaultWindow
    xmlns="https://spacestation14.io"
    SetSize="1020 620"
    Title="Wendover Free Market Exchange">
    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4">

        <!-- Header: balances -->
        <BoxContainer Orientation="Horizontal" SeparationOverride="12">
            <Label Text="Wendover Free Market Exchange" StyleClasses="LabelHeading" />
            <Control HorizontalExpand="True" />
            <Label Name="CapsLabel" Text="Caps: 0" />
            <Label Name="NcrLabel" Text="NCR: 0" />
            <Label Name="SilverLabel" Text="Silver: 0" />
            <Label Name="GoldLabel" Text="Gold: 0" />
        </BoxContainer>

        <!-- Tab bar -->
        <BoxContainer Name="TabBar" Orientation="Horizontal" SeparationOverride="2" Margin="0 2">
            <Button Name="TabExchangeBtn" Text="Market Exchange" Disabled="True" />
            <Button Name="TabCreateBtn" Text="Create Listing" />
            <Button Name="TabMyOrdersBtn" Text="My Orders &amp; Escrow" />
            <Button Name="TabActivityBtn" Text="Activity Feed" />
        </BoxContainer>

        <!-- Tab 0: Market Exchange -->
        <BoxContainer Name="TabExchange" Orientation="Horizontal" SeparationOverride="4" VerticalExpand="True">
            <!-- Left: Item Directory -->
            <ScrollContainer MinWidth="260" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="ItemDirectory" Orientation="Vertical" SeparationOverride="1" />
            </ScrollContainer>
            <!-- Center: Order Book -->
            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="OrderBookContainer" Orientation="Vertical" SeparationOverride="4" />
            </ScrollContainer>
            <!-- Right: Detail -->
            <ScrollContainer MinWidth="220" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="DetailContainer" Orientation="Vertical" SeparationOverride="4" Margin="4 0 0 0">
                    <Label Text="Select an item to view order book." StyleClasses="LabelSubText" />
                </BoxContainer>
            </ScrollContainer>
        </BoxContainer>

        <!-- Tab 1: Create Listing -->
        <BoxContainer Name="TabCreate" Orientation="Vertical" SeparationOverride="6" Visible="False" VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Orientation="Vertical" SeparationOverride="8" Margin="0 4">
                    <!-- Deposit storage -->
                    <Label Text="Your Market Storage" StyleClasses="LabelHeading" />
                    <Label Text="Right-click items near the terminal and select 'Deposit to Market' to store them here." StyleClasses="LabelSubText" />
                    <BoxContainer Name="DepositItemsContainer" Orientation="Vertical" SeparationOverride="2" />

                    <Control MinHeight="8" />

                    <!-- Proto search -->
                    <Label Text="Item Search" StyleClasses="LabelHeading" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <LineEdit Name="ProtoSearch" PlaceHolder="e.g. t51 or bars" HorizontalExpand="True" />
                        <Button Name="ProtoSearchBtn" Text="Search" MinWidth="70" />
                    </BoxContainer>
                    <BoxContainer Name="ProtoResultsContainer" Orientation="Vertical" SeparationOverride="1" />

                    <Control MinHeight="8" />

                    <!-- Order form -->
                    <Label Text="New Listing" StyleClasses="LabelHeading" />
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="Item:" MinWidth="80" VerticalAlignment="Center" />
                        <Label Name="SelectedProtoLabel" Text="(select from storage or search)" VerticalAlignment="Center" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="Type:" MinWidth="80" VerticalAlignment="Center" />
                        <OptionButton Name="OrderTypeBtn" MinWidth="120" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="Currency:" MinWidth="80" VerticalAlignment="Center" />
                        <OptionButton Name="OrderCurrencyBtn" MinWidth="120" />
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" SeparationOverride="8">
                        <Label Text="Price/unit:" MinWidth="80" VerticalAlignment="Center" />
                        <LineEdit Name="OrderPrice" PlaceHolder="10" MinWidth="80" />
                        <Label Text="Qty:" VerticalAlignment="Center" />
                        <LineEdit Name="OrderQty" PlaceHolder="1" MinWidth="60" />
                        <Label Name="OrderFeeLabel" Text="" VerticalAlignment="Center" />
                    </BoxContainer>
                    <Button Name="SubmitOrderBtn" Text="PLACE LISTING" MinWidth="140" />
                </BoxContainer>
            </ScrollContainer>
        </BoxContainer>

        <!-- Tab 2: My Orders & Escrow -->
        <BoxContainer Name="TabMyOrders" Orientation="Vertical" SeparationOverride="4" Visible="False" VerticalExpand="True">
            <Label Text="Active Orders" StyleClasses="LabelHeading" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="MyOrdersContainer" Orientation="Vertical" SeparationOverride="2" />
            </ScrollContainer>
            <Control MinHeight="8" />
            <Label Text="Completed (Claim)" StyleClasses="LabelHeading" />
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="MyCompletedContainer" Orientation="Vertical" SeparationOverride="2" />
            </ScrollContainer>
        </BoxContainer>

        <!-- Tab 3: Activity Feed -->
        <BoxContainer Name="TabActivity" Orientation="Vertical" SeparationOverride="2" Visible="False" VerticalExpand="True">
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="FeedContainer" Orientation="Vertical" SeparationOverride="1" />
            </ScrollContainer>
        </BoxContainer>

    </BoxContainer>
</DefaultWindow>
