<!-- #Cythisiax Add - Wendover Free Market GUI window -->
<controls:DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Robust.Client.UserInterface.CustomControls;assembly=Robust.Client"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Content.Client._Misfits.Trade.Market.MarketWindow"
    MinSize="800 600">
    <BoxContainer Orientation="Vertical">
        <!-- Tab bar -->
        <BoxContainer Name="TabBar" Orientation="Horizontal" SeparationOverride="2" Margin="8 4 8 0">
            <Button Name="TabMarketBtn" Text="Market" Disabled="True" />
            <Button Name="TabMyListingsBtn" Text="My Listings" />
            <Button Name="TabListNewBtn" Text="+ List Item" />
            <Button Name="TabActivityBtn" Text="Activity" />
        </BoxContainer>

        <!-- Balances bar -->
        <BoxContainer Name="BalancesBar" Orientation="Horizontal" SeparationOverride="8" Margin="8 2 8 0">
            <Label Name="CapsLabel" Text="Caps: 0" />
            <Label Name="NcrLabel" Text="NCR: 0" />
            <Label Name="SilverLabel" Text="Silver: 0" />
            <Label Name="GoldLabel" Text="Gold: 0" />
        </BoxContainer>

        <!-- Market tab -->
        <ScrollContainer Name="TabMarketContent" Visible="True" HScrollEnabled="False" VerticalExpand="True" Margin="8 4 8 8">
            <BoxContainer Name="MarketListContainer" Orientation="Vertical" />
        </ScrollContainer>

        <!-- My Listings tab -->
        <ScrollContainer Name="TabMyListingsContent" Visible="False" HScrollEnabled="False" VerticalExpand="True" Margin="8 4 8 8">
            <BoxContainer Name="MyListingsContainer" Orientation="Vertical" />
        </ScrollContainer>

        <!-- List New Item tab -->
        <ScrollContainer Name="TabListNewContent" Visible="False" HScrollEnabled="False" VerticalExpand="True" Margin="8 4 8 8">
            <BoxContainer Orientation="Vertical" SeparationOverride="8">
                <Label Text="List an item from your inventory" StyleClasses="LabelHeading" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Label Text="Prototype ID:" MinWidth="100" />
                    <LineEdit Name="ListProtoId" PlaceHolder="e.g. N14MaterialSteel1" HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Label Text="Quantity:" MinWidth="100" />
                    <LineEdit Name="ListQuantity" PlaceHolder="1" MinWidth="80" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Label Text="Stack Count:" MinWidth="100" />
                    <LineEdit Name="ListStackCount" PlaceHolder="0" MinWidth="80" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Label Text="Currency:" MinWidth="100" />
                    <OptionButton Name="ListCurrency" MinWidth="150" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Label Text="Price per unit:" MinWidth="100" />
                    <LineEdit Name="ListPrice" PlaceHolder="10" MinWidth="80" />
                    <Label Name="ListFeeLabel" Text="" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4" Visible="False" Name="BarterRow">
                    <Label Text="Requested item ID:" MinWidth="100" />
                    <LineEdit Name="ListRequestedItem" PlaceHolder="e.g. N14MaterialAntiseptic" HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" SeparationOverride="4" Visible="False" Name="BarterQtyRow">
                    <Label Text="Requested qty:" MinWidth="100" />
                    <LineEdit Name="ListRequestedQty" PlaceHolder="1" MinWidth="80" />
                </BoxContainer>
                <Button Name="ListSubmitBtn" Text="LIST ITEM (10% fee)" />
            </BoxContainer>
        </ScrollContainer>

        <!-- Activity tab -->
        <ScrollContainer Name="TabActivityContent" Visible="False" HScrollEnabled="False" VerticalExpand="True" Margin="8 4 8 8">
            <BoxContainer Name="FeedContainer" Orientation="Vertical" />
        </ScrollContainer>
    </BoxContainer>
</controls:DefaultWindow>
